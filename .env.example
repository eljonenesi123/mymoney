# MongoDB connection string. Local dev:
#   mongodb://localhost:27017/expense-tracker
# Production (MongoDB Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/expense-tracker
MONGODB_URI=mongodb://localhost:27017/expense-tracker

# Port for the Express server. Render/Railway set this automatically in production.
PORT=5000

# Deployed frontend URL(s), comma-separated if more than one (e.g. Vercel preview + prod).
# localhost:5173/4173 are always allowed for local dev regardless of this value.
CLIENT_URL=https://your-app.vercel.app

# Secret used to sign login sessions (JWTs). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep this secret and never commit a real value — anyone with it could
# forge valid login tokens for any account.
JWT_SECRET=replace-with-a-long-random-string

# Sends the welcome email on sign-up, via Gmail SMTP (no domain needed).
# 1. Turn on 2-Step Verification on the Gmail account you want to send from:
#    https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
#    (pick "Mail" as the app) — it gives you a 16-character password.
# 3. Use that Gmail address as EMAIL_USER and the app password as EMAIL_PASS
#    (not your normal Gmail login password).
# If unset, welcome emails are silently skipped — sign-up still works.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-app-password
